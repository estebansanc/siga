{
  "repo": "estebansanc/siga",
  "project": {
    "owner": "estebansanc",
    "number": 2
  },
  "branches": {
    "develop": "develop",
    "main": "main"
  },
  "environments": {
    "staging": {
      "workflow": "deploy-staging.yml",
      "url": "https://siga-orcin-staging.vercel.app"
    },
    "production": {
      "workflow": "deploy-production.yml",
      "url": "https://siga-orcin.vercel.app"
    }
  },
  "smokePaths": ["/", "/api/v1/openapi.json"],
  "worktrees": {
    "dir": "../siga-worktrees",
    "pgAdminUrl": "postgresql://crazyfarway@localhost:5432/postgres",
    "dbPrefix": "siga",
    "ports": {
      "E2E_PORT": 3200
    },
    "commands": {
      "install": "pnpm install --frozen-lockfile --silent && pnpm --silent db:generate",
      "check": "pnpm turbo lint typecheck test",
      "e2e": "pnpm test:e2e",
      "contracts": "pnpm --filter @repo/api openapi:check",
      "schema": "pnpm --filter @repo/db migrate:deploy && pnpm --filter @repo/db migrate:check",
      "migrate": "pnpm db:migrate --name"
    }
  },
  "release": {
    "file": "apps/web/lib/releases.json",
    "firstStage": "Alpha",
    "firstNumber": "0.0"
  },
  "product": {
    "name": "SiGA",
    "locale": "es-AR",
    "audience": "el usuario",
    "qaUser": "demo@example.com",
    "qaPassword": "demo1234",
    "qaUsers": [
      {
        "perfil": "Bedel",
        "email": "demo@example.com",
        "password": "demo1234"
      },
      {
        "perfil": "Docente",
        "email": "docente@example.com",
        "password": "demo1234"
      },
      {
        "perfil": "Estudiante",
        "email": "estudiante@example.com",
        "password": "demo1234"
      },
      {
        "perfil": "Autoridad",
        "email": "autoridad@example.com",
        "password": "demo1234"
      }
    ],
    "routes": ["/", "/clases", "/novedades", "/estado-institucional", "/preferencias"],
    "releaseNotesPlace": "Configuración → \"?\" (Qué hay de nuevo)"
  },
  "services": {
    "neon": {
      "project": "raspy-bird-78934396",
      "branches": ["main", "staging"]
    },
    "vercel": {
      "team": "esteban-sanchez",
      "project": "siga"
    }
  }
}
