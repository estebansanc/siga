    "@repo/config": "workspace:*",
    "@types/pg": "^8.15.5",
    "better-auth": "^1.7.2",
    "dotenv": "^17.2.2",
    "eslint": "^9.36.0",
    "prisma": "^7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
