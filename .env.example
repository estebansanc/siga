# Copiá este archivo a .env (pnpm dev:local lo hace solo). No commitear .env.

# Base de datos (Postgres local; en Vercel apuntan a Neon)
DATABASE_URL="postgresql://app:app@localhost:5432/app"
DIRECT_URL="postgresql://app:app@localhost:5432/app"
TEST_DATABASE_URL="postgresql://app:app@localhost:5432/app_test"
E2E_DATABASE_URL="postgresql://app:app@localhost:5432/app_e2e"

# Better Auth (docs/autenticacion.md)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Login con Google (opcional en local)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cron diario (docs/api.md)
CRON_SECRET=""

# Emails transaccionales (Resend, opcional en local)
RESEND_API_KEY=""
EMAIL_FROM=""

# Archivos (Cloudflare R2, solo si el producto sube archivos)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Detección de aulas desde el plano (Claude, Anthropic; opcional en local)
ANTHROPIC_API_KEY=""
DETECCION_AULAS_MODELO="haiku"
